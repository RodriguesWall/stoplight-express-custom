{
  "openapi": "3.0.0",
  "info": {
    "title": "Stoplight Express Custom — Dev Mock",
    "version": "0.0.0"
  },
  "tags": [
    { "name": "Auth" },
    { "name": "Users" },
    { "name": "Scope" }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Logout",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refresh token",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/users": {
      "get": {
        "tags": ["Users"],
        "summary": "List users",
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["Users"],
        "summary": "Create user",
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": ["Users"],
        "summary": "Get user",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" } }
      },
      "put": {
        "tags": ["Users"],
        "summary": "Replace user",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" } }
      },
      "patch": {
        "tags": ["Users"],
        "summary": "Update user",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" } }
      },
      "delete": {
        "tags": ["Users"],
        "summary": "Delete user",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "204": { "description": "No Content" } }
      }
    },
    "/scope": {
      "get": {
        "tags": ["Scope"],
        "summary": "List scopes",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/scope/{id}": {
      "get": {
        "tags": ["Scope"],
        "summary": "Get scope",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" } }
      }
    }
  }
}
